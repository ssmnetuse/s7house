DATA_BLOCK "SmartHome_DB"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
STRUCT
    Conn : TCON_IP_v4;
    Buf : Array[0..9] of Word;
    RxRegs : Array[0..9] of Word;
    TxRegs : Array[0..5] of Word;
    Cmd_LED : Bool;
    Cmd_Fan : Bool;
    Cmd_Pump : Bool;
    Cmd_Buzzer : Bool;
    Cmd_Servo : Int;
    Temp : Real;
    Humidity : Real;
    Soil : Int;
    Light : Int;
    Water : Int;
    Steam : Int;
    EspHeartbeat : Word;
    CommOk : Bool;
    CommError : Bool;
    CommStatus : Word;
END_STRUCT;
BEGIN
    Conn.ID := W#16#1;
    Conn.ConnectionType := B#16#0B;
    Conn.ActiveEstablished := TRUE;
    Conn.RemoteAddress.ADDR[1] := B#16#C0;
    Conn.RemoteAddress.ADDR[2] := B#16#A8;
    Conn.RemoteAddress.ADDR[3] := B#16#C8;
    Conn.RemoteAddress.ADDR[4] := B#16#C8;
    Conn.RemotePort := 502;
    Conn.LocalPort := 0;
    Cmd_Servo := 180;
END_DATA_BLOCK


FUNCTION_BLOCK "FB_SmartHome"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Enable : Bool;
END_VAR
VAR
    mb : MB_CLIENT;
    state : Int;
    req : Bool;
    done : Bool;
    busy : Bool;
    err : Bool;
    stat : Word;
    mode : USInt;
    addr : UDInt;
    len : UInt;
    hbTimer : TON_TIME;
    hbCount : UInt;
END_VAR
BEGIN
    // Heartbeat zum ESP32 (zaehlt jede Sekunde hoch)
    #hbTimer(IN := NOT #hbTimer.Q, PT := T#1s);
    IF #hbTimer.Q THEN
        #hbCount := #hbCount + 1;
    END_IF;

    // Befehle in Sende-Register
    "SmartHome_DB".TxRegs[0] := BOOL_TO_WORD("SmartHome_DB".Cmd_LED);
    "SmartHome_DB".TxRegs[1] := BOOL_TO_WORD("SmartHome_DB".Cmd_Fan);
    "SmartHome_DB".TxRegs[2] := BOOL_TO_WORD("SmartHome_DB".Cmd_Pump);
    "SmartHome_DB".TxRegs[3] := BOOL_TO_WORD("SmartHome_DB".Cmd_Buzzer);
    "SmartHome_DB".TxRegs[4] := INT_TO_WORD(LIMIT(MN := 0, IN := "SmartHome_DB".Cmd_Servo, MX := 180));
    "SmartHome_DB".TxRegs[5] := UINT_TO_WORD(#hbCount);

    // Ein einziger Modbus-Aufruf
    #mb(REQ := #req,
        DISCONNECT := FALSE,
        MB_MODE := #mode,
        MB_DATA_ADDR := #addr,
        MB_DATA_LEN := #len,
        MB_DATA_PTR := "SmartHome_DB".Buf,
        CONNECT := "SmartHome_DB".Conn,
        DONE => #done,
        BUSY => #busy,
        ERROR => #err,
        STATUS => #stat);

    IF NOT #Enable THEN
        #state := 0;
        #req := FALSE;
    END_IF;

    CASE #state OF
        0:
            IF #Enable THEN #state := 1; END_IF;
        1:  // Lesen starten: 10 Register ab 40001
            #mode := USINT#0;
            #addr := UDINT#40001;
            #len := UINT#10;
            #req := TRUE;
            #state := 2;
        2:
            IF #done THEN
                "SmartHome_DB".RxRegs := "SmartHome_DB".Buf;
                #req := FALSE;
                #state := 4;
            ELSIF #err THEN
                #req := FALSE;
                #state := 4;
            END_IF;
        4:  // Schreiben starten: 6 Register ab 40011
            "SmartHome_DB".Buf[0] := "SmartHome_DB".TxRegs[0];
            "SmartHome_DB".Buf[1] := "SmartHome_DB".TxRegs[1];
            "SmartHome_DB".Buf[2] := "SmartHome_DB".TxRegs[2];
            "SmartHome_DB".Buf[3] := "SmartHome_DB".TxRegs[3];
            "SmartHome_DB".Buf[4] := "SmartHome_DB".TxRegs[4];
            "SmartHome_DB".Buf[5] := "SmartHome_DB".TxRegs[5];
            #mode := USINT#1;
            #addr := UDINT#40011;
            #len := UINT#6;
            #req := TRUE;
            #state := 5;
        5:
            IF #done OR #err THEN
                #req := FALSE;
                #state := 1;
            END_IF;
        ELSE
            #state := 0;
    END_CASE;

    // Status
    IF #done THEN
        "SmartHome_DB".CommOk := TRUE;
        "SmartHome_DB".CommError := FALSE;
    END_IF;
    IF #err THEN
        "SmartHome_DB".CommOk := FALSE;
        "SmartHome_DB".CommError := TRUE;
        "SmartHome_DB".CommStatus := #stat;
    END_IF;

    // Messwerte umrechnen
    "SmartHome_DB".Temp := INT_TO_REAL(WORD_TO_INT("SmartHome_DB".RxRegs[0])) / 10.0;
    "SmartHome_DB".Humidity := INT_TO_REAL(WORD_TO_INT("SmartHome_DB".RxRegs[1])) / 10.0;
    "SmartHome_DB".Soil := WORD_TO_INT("SmartHome_DB".RxRegs[2]);
    "SmartHome_DB".Light := WORD_TO_INT("SmartHome_DB".RxRegs[3]);
    "SmartHome_DB".Water := WORD_TO_INT("SmartHome_DB".RxRegs[4]);
    "SmartHome_DB".Steam := WORD_TO_INT("SmartHome_DB".RxRegs[5]);
    "SmartHome_DB".EspHeartbeat := "SmartHome_DB".RxRegs[9];
END_FUNCTION_BLOCK
